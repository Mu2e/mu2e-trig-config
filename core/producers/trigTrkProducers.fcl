BEGIN_PROLOG

TrigTrkProducers : {
  TrigMakeSD: {
    @table::DAQ.producers.makeSD
  }

  TrigMakeSHFromDigi: {
    @table::TrkHitReco.producers.makeSH
    MinimumTimeOffSpill : 0
    MaximumTimeOffSpill : 100000
    FitType                 : 5
    FilterHits              : false
    WriteStrawHitCollection : false
    StrawDigiADCWaveformCollectionTag : "notUsed"
  }

  TrigMakeSH: {
    @table::TrkHitReco.producers.makeSH
    MinimumTimeOffSpill : 0
    MaximumTimeOffSpill : 100000
    FitType                 : 5
    FilterHits              : false
    WriteStrawHitCollection : false
    StrawDigiADCWaveformCollectionTag : "notUsed"
    StrawDigiCollectionTag : "TrigMakeSD"
    ProtonBunchTimeTag : "ProcessCFOData"
    EventWindowMarker  : "ProcessCFOData"
  }

  TrigMakePH: {
    @table::TrkHitReco.producers.makePH
    TestFlag   : true # required as makeSH no longer filters hits
    FilterHits : false
    MinimumTimeOffSpill : 0
    MinimumTimeOffSpill : 100000
    ComboHitCollection    : "TrigMakeSH"
    StrawHitSelectionBits : ["TimeSelection"]
    StrawHitMask          : ["Dead"]
    EventWindowMarker     : "ProcessCFOData"
  }

  # combine panel hits in a station
  TrigMakeSTH : {
    @table::TrkHitReco.producers.makeSTH
    TestFlag           : false
    FilterHits         : true
    ComboHitCollection : "TrigMakePH"
  }

  TrigFlagBkgHits: {
    @table::TrkHitReco.producers.FlagBkgHits
    ComboHitCollection   : "TrigMakeSTH"
    FilterHits           : true
  }

  TTDeltaFinder: {
    @table::CalPatRec.producers.DeltaFinder
    chCollTag                     : TrigMakePH                # input coll
    sschCollTag                   : TrigMakeSH                # input coll
    writeFilteredComboHits        : 0
    writeStrawHits                : 0
  }

  TrigHelixFinderParams: {
    @table::TrkReco.HelixFinderParams
    maxEDepAvg : 0.0025
  }
}

# This next defines which hit flagger to use
TrigTrkProducers : {
  @table::TrigTrkProducers
  TrigFlagPH: @local::TrigTrkProducers.TTDeltaFinder
}

TrigTrkProducers : {
  @table::TrigTrkProducers
  TrigOffSpMakeSH: {
    @table::TrigTrkProducers.TrigMakeSH
    MinimumTime : 0
    MaximumTime : 100000
    MinimumRadius : 0
    MaximumRadius : 800
    MinimumEnergy : 0
    MaximumEnergy : 1
  }
  TrigOffSpMakeSHFromDigi: {
    @table::TrigTrkProducers.TrigMakeSHFromDigi
    MinimumTime : 0
    MaximumTime : 100000
    MinimumRadius : 0
    MaximumRadius : 800
    MinimumEnergy : 0
    MaximumEnergy : 1
  }
  TrigOffSpMakePH: {
    @table::TrigTrkProducers.TrigMakePH
    MinimumTime : 0
    MinimumTime : 100000
    MinimumRadius : 0
    MaximumRadius : 800
    MinimumEnergy : 0
    MaximumEnergy : 1
    ComboHitCollection    : "TrigOffSpMakeSH"
  }
}

# Add producers for basic tracking paths
TrigTrkProducers : {
  @table::TrigTrkProducers

  TrkTCTriggerInfoMerger: { module_type: "MergeTriggerInfo" }
  TrkSHTriggerInfoMerger: { module_type: "MergeTriggerInfo" }

  # Hit-making for commissioning
  TrigComMakeSH: {
      @table::TrkHitReco.producers.makeSH
      FitType                           : 5
      FilterHits                        : false
      WriteStrawHitCollection           : true
      MinimumTime                       : 0
      MaximumTime                       : 200000
      MinimumEnergy                     : 0.0005
      MaximumEnergy                     : 0.005
      MinimumRadius                     : 350.0
      MaximumRadius                     : 750.0
      StrawDigiCollectionTag            : "TrigMakeSD"
      StrawDigiADCWaveformCollectionTag : "notUsed"
      ProtonBunchTimeTag                : "ProcessCFOData"
      EventWindowMarker                 : "ProcessCFOData"
      UseCalorimeter                    : false
      clusterDt                         : 100.0
      CaloClusterCollectionTag          : "notUsed"
      FlagCrossTalk                     : false
      crossTalkEnergy                   : 0.007
      crossTalkMinimumTime              : -1
      crossTalkMaximumTime              : 100
  }

  # Simple time clustering
  TrkTCSimpleTimeCluster: {
      module_type              : SimpleTimeCluster
      ComboHitCollection       : "TrigComMakeSH"
      TestFlag                 : true
      HitSelectionBits         : []
      HitBackgroundBits        : ["Background","Noisy","Dead"]
      HitNonNoiseSelectionBits : ["EnergySelection"]
      debugLevel               : 0
      minNStrawHits            : 8
      minNPanels               : 2
      TimeWindow               : 400
      useTimeWindow            : true
      TimeStep                 : 100
      useTimeStep              : false
      UseOnlyOnePanel          : false
      UseOnlyOnePlane          : false
  }
}

END_PROLOG
